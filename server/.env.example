# ==============================================
# Server Environment Variables Configuration
# Copy this file to .env and replace with your credentials
# ==============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-cold-email?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Groq Cloud AI API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Nodemailer SMTP Configuration (Gmail App Password)
# Note: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Brevo HTTP API (Recommended: Sends 300 free emails/day to ANY email address, No domain required)
# Get free API key from https://brevo.com
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER=your_verified_gmail_on_brevo@gmail.com

# Resend HTTP API (Optional alternative)
# Get free API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ColdMail AI <onboarding@resend.dev>"



